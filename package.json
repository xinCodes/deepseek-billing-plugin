{
  "name": "deepseek-billing-plugin",
  "version": "0.1.0-rc.5",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "bundle": "pnpm --filter @deepseek-ai/dsh-client-ui-deepseek-billing bundle",
    "build": "pnpm typecheck && pnpm bundle",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
